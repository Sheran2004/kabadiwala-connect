# ---- copy to backend/.env (never commit it) ----
KC_ENV=development              # production on a real server (hides /docs, requires KC_JWT_SECRET)
DATABASE_URL=sqlite:///./kabadiwala.db
KC_JWT_SECRET=
KC_ORIGINS=http://localhost:5500

# AI (console.groq.com, aistudio.google.com). Models are auto-detected.
GROQ_API_KEY=
GEMINI_API_KEY=

# OTP. Local dev: SMS_PROVIDER=console prints the OTP in the backend terminal; KC_DEBUG_OTP=1 also shows it on screen.
# Real SMS (India): SMS_PROVIDER=fast2sms + FAST2SMS_KEY (+ FAST2SMS_ROUTE), then REMOVE KC_DEBUG_OTP. Test with: py -3.12 check_sms.py 98xxxxxxxx
SMS_PROVIDER=console
KC_DEBUG_OTP=1
FAST2SMS_KEY=
FAST2SMS_ROUTE=q                 # q (Quick SMS) | otp (old OTP route) | otp_api (Fast2SMS creates + verifies the OTP; also set FAST2SMS_OTP_ID)
FAST2SMS_OTP_ID=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Optional: auto-create the first REAL admin on a fresh server (strong password, 10+ characters)
ADMIN_PHONE=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
